{
  "name": "dsh-plugin-everything",
  "version": "1.0.2",
  "description": "Search the local machine through the Everything index: instant filename lookup and content search over the indexed volumes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luys521/dsh-plugin-everything.git"
  },
  "homepage": "https://github.com/Luys521/dsh-plugin-everything#readme",
  "bugs": {
    "url": "https://github.com/Luys521/dsh-plugin-everything/issues"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.zh.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs && node scripts/check-peers.mjs",
    "check:peers": "node scripts/check-peers.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "everything",
    "search",
    "windows",
    "file-index"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1 || ^0.1.5-rc.2"
  },
  "devDependencies": {
    "semver": "^7.6.0"
  }
}
